{
  "name": "gemidos-premium-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Herramientas de desarrollo para la app Android Gemidos PREMIUM.",
  "scripts": {
    "test": "npm run test:audio-plan && node tools/verify-project.mjs && npm --prefix apps/mobile run test",
    "test:audio-plan": "node --test --experimental-test-coverage --test-coverage-include=tools/premium-celebration-plan.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tools/premium-celebration-plan.test.mjs",
    "test:android": "npm --prefix apps/mobile run test:android",
    "test:audio": "node tools/verify-premium-audio.mjs",
    "coverage": "npm --prefix apps/mobile run coverage",
    "lint": "npm --prefix apps/mobile run lint",
    "check:version": "node tools/verify-version.mjs",
    "build:apk": "npm --prefix apps/mobile run build:apk",
    "install:android": "npm --prefix apps/mobile run install:android"
  },
  "engines": {
    "node": ">=24"
  }
}
